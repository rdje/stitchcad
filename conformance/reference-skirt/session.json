  "recipe": "let garment_waist: length = waist_girth + ease_waist\nlet garment_hip: length = hip_girth + ease_hip\nlet quarter_waist: length = garment_waist / 4\nlet quarter_hip: length = garment_hip / 4\nlet suppression: length = quarter_hip - quarter_waist\nlet dart_intake: length = suppression - ss_suppress\nlet side_seam_total: length = 4 * ss_suppress\nlet dart_total: length = 4 * dart_intake\nlet front_dart_centre: length = (quarter_hip - ss_suppress) / 2\nlet back_dart_centre: length = (quarter_hip - ss_suppress) / 2\nlet waist_side: length = quarter_hip - ss_suppress\nlet quarter_hem_width: length = quarter_hip + a_line_flare\nlet garment_hem: length = 4 * quarter_hem_width\nlet hip_to_hem_drop: length = waist_to_hem - waist_to_hip\nlet side_seam_length: length = hypot(hip_to_hem_drop, a_line_flare)\nlet waistband_pattern_length: length = garment_waist + 2 * sa_cb + wb_extension\nlet waistband_cut_width: length = 2 * wb_width + sa_waist + sa_wb_bottom\nlet waistband_fold_position: length = waistband_cut_width / 2\nlet waistband_finished_length: length = waistband_pattern_length - 2 * sa_cb\nlet wb_interfacing_width: length = wb_width\nlet wb_interfacing_length: length = waistband_finished_length\nassert allocation_balance: eps_num = 4 * (ss_suppress + dart_intake) == garment_hip - garment_waist\nassert waist_closure: eps_num = (quarter_hip - ss_suppress) - dart_intake == quarter_waist\nassert waistband_length_closure: eps_num = waistband_pattern_length - 2 * sa_cb - wb_extension == garment_waist\nassert waistband_width_closure: eps_num = waistband_cut_width - sa_waist - sa_wb_bottom == 2 * wb_width\nlet front_dart_near: length = front_dart_centre - dart_intake / 2\nlet front_dart_far: length = front_dart_centre + dart_intake / 2\nlet back_dart_near: length = back_dart_centre - dart_intake / 2\nlet back_dart_far: length = back_dart_centre + dart_intake / 2\nlet grain_x: length = quarter_hip / 2\nlet waist_curve_lower_y: length = waist_to_hip / 2\nlet waist_curve_upper_x: length = waist_side + ss_suppress / 3\nlet waist_curve_upper_y: length = waist_to_hip / 6\nlet notch_depth: length = 5 mm\nlet hip_notch_x: length = quarter_hip + sa_side\nlet hip_notch_end: length = hip_notch_x - notch_depth\nlet cb_notch_x: length = sa_cb - notch_depth\nlet label_y: length = waist_to_hip + 40 mm\nlet label_lower_y: length = label_y + 16 mm\nlet band_right: length = waistband_pattern_length - sa_cb\nlet band_top: length = waistband_cut_width - sa_wb_bottom\nlet band_mid: length = waistband_pattern_length / 2\nlet band_grain_left: length = sa_cb + 20 mm\nlet band_grain_right: length = band_right - 20 mm\nlet band_grain_y: length = waistband_cut_width / 4\nlet band_cb_left: length = sa_cb + garment_waist\nlet band_quarter_1: length = sa_cb + garment_waist / 4\nlet band_quarter_2: length = sa_cb + garment_waist / 2\nlet band_quarter_3: length = sa_cb + 3 * garment_waist / 4\nlet band_label_y: length = waistband_fold_position + 10 mm\nlet band_label_x: length = sa_cb + 40 mm\nlet interfacing_grain_y: length = wb_interfacing_width / 2\nlet interfacing_grain_left: length = 10 mm\nlet interfacing_grain_right: length = wb_interfacing_length - 10 mm\nlet interfacing_label_y: length = wb_interfacing_width - 8 mm\n",
